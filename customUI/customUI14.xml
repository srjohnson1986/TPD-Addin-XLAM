<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabTPD" label="TPD">
        <group id="grpTPDSheetTools" label="Sheet Tools">
          <button id="btnInsertCustEQList"
                  label="Create Customer EQ List"
                  onAction="RunCreateCustEQList"
                  imageMso="NewTableStyle2"
                  size="large"
                  screentip="Create Customer EQ List"
                  supertip="Opens the column picker, then copies the data to a new Customer EQ List sheet and formats it."/>
          <button id="btnInsertCustSchedule"
                  label="Create Customer Schedule"
                  onAction="RunCreateCustSchedule"
                  imageMso="TableInsertRowsAbove"
                  size="large"
                  screentip="Create Customer Schedule"
                  supertip="Opens the column picker, then copies the data to a new Customer Schedule sheet and formats it."/>
          <button id="btnSplitSheetByColumn"
                  label="Split Sheet by Column"
                  onAction="SplitSheetByColumn"
                  imageMso="TableSplitTable"
                  size="large"
                  screentip="Split Sheet by Column"
                  supertip="Opens the options picker, then creates one sheet per unique value in the chosen group column."/>
          <button id="btnExportSheetsToXLSX"
                  label="Save Each Sheet to XLSX"
                  onAction="RunExportSheetsToXLSX"
                  imageMso="ExportExcel"
                  size="large"/>
        </group>
        <group id="grpTPDDefaults" label="One-click">
          <button id="btnQuickEqList"
                  label="EQ List"
                  onAction="RunQuickEqList"
                  imageMso="NewTableStyle2"
                  size="normal"
                  screentip="EQ List (one-click)"
                  supertip="Creates a Customer EQ List straight from your saved TPD defaults - no column picker."/>
          <button id="btnQuickSchedule"
                  label="Schedule"
                  onAction="RunQuickSchedule"
                  imageMso="TableInsertRowsAbove"
                  size="normal"
                  screentip="Schedule (one-click)"
                  supertip="Creates a Customer Schedule straight from your saved TPD defaults - no column picker."/>
          <button id="btnQuickSplitSheets"
                  label="Split Sheets"
                  onAction="RunQuickSplitSheets"
                  imageMso="TableSplitTable"
                  size="normal"
                  screentip="Split Sheets (one-click)"
                  supertip="Splits the active sheet straight from your saved TPD defaults - no options picker."/>
          <button id="btnSetTPDDefaults"
                  label="Set Defaults"
                  onAction="RunSetTPDDefaults"
                  imageMso="TablePropertiesDialog"
                  size="large"
                  screentip="Set Defaults"
                  supertip="Configure the default column lists the one-click buttons and the pickers fall back to."/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
