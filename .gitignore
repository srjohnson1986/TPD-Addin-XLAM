# ---- Excel scratch / lock files ----
# Excel creates these while a file is open - never useful to track
~$*.xlsx
~$*.xlsm
~$*.xlam
*.tmp

# ---- Local build output ----
# The built .xlam is a generated artifact (see /build workflow), not source.
# It belongs on GitHub Releases, not in the repo history. The /build/_base
# base file (worksheets/ribbon/logo that live outside /src) is a local
# prerequisite supplied per contributor - see CONTRIBUTING.md.
/build/**/*.xlam
/build/**/*.xlsm
/build/**/*.xls
/build/**/*.log
/build/*.xlam
/build/*.xlsm
/build/*.xls
/build/*.log

# Per-component import logs the builder drops next to /src files on error.
src/**/*.log

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor/backup junk ----
*.bak
*~
